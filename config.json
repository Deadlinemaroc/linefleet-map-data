{
  "_comment": "Synced from LINEFLEET_TRT docker/tiles/ (the dev/local twin) — keep the pair in sync; the PRODUCTION rebuild runs HERE. tileserver-gl only reads options/styles/data, so this key is ignored at serve time.",
  "options": {
    "paths": {
      "root": "/data",
      "fonts": "fonts",
      "sprites": "sprites",
      "styles": "styles",
      "mbtiles": "data",
      "pmtiles": "data"
    },
    "maxSize": 4096,
    "maxScaleFactor": 2,
    "minRendererPoolSizes": [1, 1, 0],
    "maxRendererPoolSizes": [2, 2, 1]
  },
  "styles": {
    "liberty": {
      "style": "liberty.json",
      "serve_rendered": true,
      "serve_data": true
    }
  },
  "data": {
    "morocco": {
      "pmtiles": "morocco.pmtiles"
    }
  }
}
