{
  "options": {
    "paths": {
      "root": "/data",
      "fonts": "fonts",
      "sprites": "sprites",
      "styles": "styles",
      "mbtiles": "data",
      "pmtiles": "data"
    },
    "maxSize": 4096,
    "maxScaleFactor": 2,
    "minRendererPoolSizes": [
      1,
      1,
      0
    ],
    "maxRendererPoolSizes": [
      2,
      2,
      1
    ]
  },
  "styles": {
    "liberty": {
      "style": "liberty.json",
      "serve_rendered": true,
      "serve_data": true
    },
    "liberty-dark": {
      "style": "liberty-dark.json",
      "serve_rendered": true,
      "serve_data": true
    }
  },
  "data": {
    "morocco": {
      "pmtiles": "morocco.pmtiles"
    },
    "places": {
      "mbtiles": "places.mbtiles"
    }
  }
}
